    {"type":"text","id":"evHandshakeCap","x":1180,"y":188,"width":440,"height":20,"text":"증거 ① connect 핸드셰이크 — 권한을 연결에 고정","originalText":"증거 ① connect 핸드셰이크 — 권한을 연결에 고정","fontSize":13,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#3b82f6","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":400001,"version":1,"versionNonce":1,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null,"lineHeight":1.25},
    {"type":"rectangle","id":"evHandshakeBox","x":1180,"y":212,"width":440,"height":210,"angle":0,"strokeColor":"#0f172a","backgroundColor":"#1e293b","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"seed":400002,"version":1,"versionNonce":1,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false},
    {"type":"text","id":"evHandshakeT","x":1198,"y":228,"width":404,"height":180,"text":"// 클라 → 서버\nconnect {\n  client:{ id:\"gateway-client\", mode:\"backend\" },\n  auth:{ token | deviceToken | bootstrapToken },\n  device:{ publicKey, signature, nonce }\n}\n// 서버 → 클라\nhello-ok {\n  auth:{ role, scopes },   // ← granted\n  policy:{ maxPayload, tickIntervalMs }\n}","originalText":"// 클라 → 서버\nconnect {\n  client:{ id:\"gateway-client\", mode:\"backend\" },\n  auth:{ token | deviceToken | bootstrapToken },\n  device:{ publicKey, signature, nonce }\n}\n// 서버 → 클라\nhello-ok {\n  auth:{ role, scopes },   // ← granted\n  policy:{ maxPayload, tickIntervalMs }\n}","fontSize":12,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#22c55e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":400003,"version":1,"versionNonce":1,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null,"lineHeight":1.3},

    {"type":"text","id":"evAuthCap","x":1140,"y":628,"width":480,"height":20,"text":"증거 ② authorizeGatewayMethod — 디스패치 전 매번","originalText":"증거 ② authorizeGatewayMethod — 디스패치 전 매번","fontSize":13,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#3b82f6","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":400004,"version":1,"versionNonce":1,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null,"lineHeight":1.25},
    {"type":"rectangle","id":"evAuthBox","x":1140,"y":652,"width":480,"height":230,"angle":0,"strokeColor":"#0f172a","backgroundColor":"#1e293b","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"seed":400005,"version":1,"versionNonce":1,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false},
    {"type":"text","id":"evAuthT","x":1158,"y":668,"width":444,"height":200,"text":"role = parseGatewayRole(connect.role)\nif (!isRoleAuthorizedForMethod(role, method))\n    → \"unauthorized role\"\nif (role === \"node\") return ok\nif (scopes.includes(ADMIN_SCOPE)) return ok\nif (!authorizeOperatorScopesForMethod(\n        method, scopes, params).allowed)\n    → \"missing scope: \" + missingScope\n// scopes = client.connect.scopes (연결 고정)","originalText":"role = parseGatewayRole(connect.role)\nif (!isRoleAuthorizedForMethod(role, method))\n    → \"unauthorized role\"\nif (role === \"node\") return ok\nif (scopes.includes(ADMIN_SCOPE)) return ok\nif (!authorizeOperatorScopesForMethod(\n        method, scopes, params).allowed)\n    → \"missing scope: \" + missingScope\n// scopes = client.connect.scopes (연결 고정)","fontSize":12,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#22c55e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":400006,"version":1,"versionNonce":1,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null,"lineHeight":1.3}
