    {"type":"text","id":"s2_t","x":372,"y":198,"width":236,"height":24,"text":"② Enablement + Validation","originalText":"② Enablement + Validation","fontSize":15,"fontFamily":3,"textAlign":"center","verticalAlign":"middle","strokeColor":"#1e40af","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":300021,"version":1,"versionNonce":1,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":"s2","lineHeight":1.25},
    {"type":"text","id":"s2_d","x":360,"y":260,"width":270,"height":110,"text":"config ↔ manifest 검증\n· configSchema 로 설정 검사\n· enabledByDefault / 자동 활성\n· activation plan 계산\n  (onProviders/onChannels/\n   onCommands/onCapabilities)","originalText":"config ↔ manifest 검증\n· configSchema 로 설정 검사\n· enabledByDefault / 자동 활성\n· activation plan 계산\n  (onProviders/onChannels/\n   onCommands/onCapabilities)","fontSize":12,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#64748b","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":300022,"version":1,"versionNonce":1,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null,"lineHeight":1.4},

