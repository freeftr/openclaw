    {"type":"text","id":"s1_t","x":62,"y":198,"width":236,"height":24,"text":"① Manifest + Discovery","originalText":"① Manifest + Discovery","fontSize":15,"fontFamily":3,"textAlign":"center","verticalAlign":"middle","strokeColor":"#1e40af","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":300011,"version":1,"versionNonce":1,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":"s1","lineHeight":1.25},
    {"type":"text","id":"s1_d","x":50,"y":260,"width":270,"height":110,"text":"openclaw.plugin.json 스캔\n· channels[] / providers[] (소유 id)\n· configSchema · activation 규칙\n· modelSupport (prefix/pattern)\n\n→ 플러그인 코드는 실행 안 됨","originalText":"openclaw.plugin.json 스캔\n· channels[] / providers[] (소유 id)\n· configSchema · activation 규칙\n· modelSupport (prefix/pattern)\n\n→ 플러그인 코드는 실행 안 됨","fontSize":12,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#64748b","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":300012,"version":1,"versionNonce":1,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null,"lineHeight":1.4},

