    {"type":"text","id":"title","x":40,"y":24,"width":1000,"height":36,"text":"플러그인 시스템: 4개 레이어 + 코어 경계","originalText":"플러그인 시스템: 4개 레이어 + 코어 경계","fontSize":28,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#1e40af","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":300001,"version":1,"versionNonce":1,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null,"lineHeight":1.25},
    {"type":"text","id":"subtitle","x":40,"y":66,"width":1100,"height":22,"text":"채널·프로바이더는 전부 플러그인. 정적 manifest(openclaw.plugin.json)를 코드 실행 전에 먼저 검사한다 → plugin-agnostic core.","originalText":"채널·프로바이더는 전부 플러그인. 정적 manifest(openclaw.plugin.json)를 코드 실행 전에 먼저 검사한다 → plugin-agnostic core.","fontSize":15,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#64748b","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":300002,"version":1,"versionNonce":1,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null,"lineHeight":1.25},

