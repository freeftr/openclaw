    { "id": "r5_left_t", "type": "text", "x": 105, "y": 768, "width": 440, "height": 48, "angle": 0, "strokeColor": "#374151", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "seed": 205002, "version": 1, "versionNonce": 205002, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "⑤ push-to-wake\n오프라인 노드 APNs/FCM 깨움 → 연결 시 invoke", "fontSize": 14, "fontFamily": 2, "textAlign": "center", "verticalAlign": "middle", "containerId": "r5_left", "originalText": "⑤ push-to-wake\n오프라인 노드 APNs/FCM 깨움 → 연결 시 invoke", "lineHeight": 1.25 },
    { "id": "r5_right", "type": "rectangle", "x": 840, "y": 744, "width": 640, "height": 96, "angle": 0, "strokeColor": "#1e3a5f", "backgroundColor": "#93c5fd", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "seed": 205003, "version": 1, "versionNonce": 205003, "isDeleted": false, "boundElements": [{"type":"text","id":"r5_right_t"}], "updated": 1, "link": null, "locked": false, "roundness": {"type":3} },
    { "id": "r5_right_t", "type": "text", "x": 855, "y": 768, "width": 610, "height": 48, "angle": 0, "strokeColor": "#374151", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "seed": 205004, "version": 1, "versionNonce": 205004, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "FCM 고우선순위 = 잠든 기기 wake — 단 전달 보장 아님\ninactive ~15% drop · Doze 지연 사실상 무한", "fontSize": 14, "fontFamily": 2, "textAlign": "center", "verticalAlign": "middle", "containerId": "r5_right", "originalText": "FCM 고우선순위 = 잠든 기기 wake — 단 전달 보장 아님\ninactive ~15% drop · Doze 지연 사실상 무한", "lineHeight": 1.25 },
